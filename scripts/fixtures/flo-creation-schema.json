  "constraintsAndTriggers": [
    {
      "kind": "constraint",
      "relation": "bills",
      "name": "bills_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "kind": "constraint",
      "relation": "bills",
      "name": "bills_smart_priority_check",
      "definition": "CHECK ((smart_priority = ANY (ARRAY['must'::text, 'flexible'::text, 'optional'::text])))"
    },
    {
      "kind": "constraint",
      "relation": "transactions",
      "name": "transactions_linked_plan_type_check",
      "definition": "CHECK (((linked_plan_type IS NULL) OR (linked_plan_type = ANY (ARRAY['goal'::text, 'decision'::text, 'snowball'::text, 'transaction'::text]))))"
    },
    {
      "kind": "constraint",
      "relation": "transactions",
      "name": "transactions_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "kind": "constraint",
      "relation": "transactions",
      "name": "transactions_review_allocations_array_check",
      "definition": "CHECK ((jsonb_typeof(review_allocations) = 'array'::text))"
    },
    {
      "kind": "constraint",
      "relation": "transactions",
      "name": "transactions_review_resolution_check",
      "definition": "CHECK (((review_resolution IS NULL) OR (review_resolution = ANY (ARRAY['bill'::text, 'income'::text, 'goal'::text, 'decision'::text, 'snowball'::text, 'manual'::text, 'category'::text, 'transfer'::text]))))"
    },
    {
      "kind": "constraint",
      "relation": "transactions",
      "name": "transactions_review_status_check",
      "definition": "CHECK ((review_status = ANY (ARRAY['needs_review'::text, 'matched'::text, 'categorized'::text, 'transfer'::text, 'legacy_reviewed'::text])))"
    },
    {
      "kind": "constraint",
      "relation": "incomes",
