{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "test:api": "node --test api/_utils/*.test.js",
    "test:flo": "node --test --experimental-strip-types supabase/functions/flo-chat/contract.test.mjs",
    "test:edge": "node --test --experimental-strip-types supabase/functions/flo-chat/contract.test.mjs supabase/functions/billing-dispatcher/contract.test.mjs",
    "test:release-fixture": "node --test scripts/seed-reviewer-fixture.test.mjs",
    "test:mobile": "pnpm --filter @workspace/mobile run test",
    "test": "pnpm run test:api && pnpm run test:edge && pnpm run test:release-fixture && pnpm run test:mobile",
    "build": "pnpm run check:mobile-config && pnpm run test && pnpm run typecheck && pnpm -r --if-present run build",
    "build:store-screenshots": "node scripts/build-store-screenshot-drafts.mjs",
    "check:mobile-config": "node scripts/assert-mobile-config.cjs",
    "verify": "pnpm run build && pnpm audit --prod --audit-level high",
    "typecheck:libs": "tsc --build --force",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@babel/generator": "7.29.1",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "7.29.0",
    "eas-cli": "^20.0.0",
    "expo-doctor": "1.20.2",
    "prettier": "^3.8.1",
    "sharp": "0.34.3",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.37",
    "@supabase/supabase-js": "2.108.0",
    "ai": "7.0.59",
    "jose": "6.2.3",
    "plaid": "43.0.0",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  }
}
