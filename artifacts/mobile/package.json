{
  "name": "@workspace/mobile",
  "version": "0.0.0",
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-plaid-link-sdk"
        ]
      }
    }
  },
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_EXPO_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "pretest": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/*.test.js",
    "phase0:check": "pnpm run test && pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
