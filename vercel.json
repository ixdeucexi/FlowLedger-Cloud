{
  "crons": [
    {
      "path": "/api/plaid/automatic-sync",
      "schedule": "24 22 * * *"
    },
    {
      "path": "/api/notifications/overdue-bills",
      "schedule": "15 14 * * *"
    },
    {
      "path": "/api/money-health/nightly",
      "schedule": "10 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.flowledger-algo.com"
        }
      ],
      "destination": "https://flowledger-algo.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "flow-ledger-cloud.vercel.app"
        }
      ],
      "destination": "https://flowledger-algo.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/_expo/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/static-build/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:page(login|legal|setup|bills|monthly|flo|transactions|more)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/notifications/:notificationAction(config|overdue-bills|preferences|subscription|test)",
      "destination": "/api/notifications?notificationAction=:notificationAction"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
