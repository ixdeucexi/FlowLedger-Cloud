{
  "crons": [
    {
      "path": "/api/plaid/automatic-sync",
      "schedule": "24 22 * * *"
    },
    {
      "path": "/api/plaid/daily-close",
      "schedule": "55 5 * * *"
    },
    {
      "path": "/api/notifications/overdue-bills",
      "schedule": "15 14 * * *"
    },
    {
      "path": "/api/money-health/nightly",
      "schedule": "10 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.flowledger-algo.com"
        }
      ],
      "destination": "https://flowledger-algo.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "flow-ledger-cloud.vercel.app"
        }
      ],
      "destination": "https://flowledger-algo.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.plaid.com; script-src 'self' 'unsafe-inline' https://cdn.plaid.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.plaid.com https://cdn.plaid.com; frame-src 'self' https://*.plaid.com; child-src 'self' blob: https://*.plaid.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/_expo/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/FlowLedger-User-Guide.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/static-build/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:page(login|setup|accounts|add|bills|category-budget|flo|how-flowledger-works|monthly|more|reports|review|transactions|zero-budget-lab|delete-account|plan-simulator|planned-debt-payment|snowball-plan|support|user-guide|legal)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/auth/:page(callback|reset-password)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/account/delete",
      "destination": "/api/feedback?accountAction=delete"
    },
    {
      "source": "/api/account/apple-authorization",
      "destination": "/api/feedback?accountAction=apple-authorization"
    },
    {
      "source": "/api/plaid/attach-credit-card",
      "destination": "/api/plaid/sync?plaidAction=attach-credit-card"
    },
    {
      "source": "/api/plaid/account-nickname",
      "destination": "/api/plaid/sync?plaidAction=account-nickname"
    },
    {
      "source": "/api/notifications/:notificationAction(config|overdue-bills|preferences|receipts|subscription|test)",
      "destination": "/api/notifications?notificationAction=:notificationAction"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
